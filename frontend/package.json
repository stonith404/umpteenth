{
	"name": "umpteenth-frontend",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"dev": "vite dev --port 3000",
		"build": "vite build && node scripts/keep-embed-placeholder.mjs",
		"preview": "vite preview --port 3000",
		"dev:demo": "vite --config vite.demo.config.ts --port 3005",
		"build:demo": "svelte-kit sync && vite build --config vite.demo.config.ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"gen:api": "cd ../backend && go run -tags exclude_frontend ./cmd/umpteenth openapi > ../frontend/openapi.tmp.json && cd ../frontend && mv openapi.tmp.json openapi.json && openapi-typescript openapi.json -o src/lib/api/schema.d.ts && prettier --write openapi.json src/lib/api/schema.d.ts"
	},
	"dependencies": {
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/lang-markdown": "^6.5.2",
		"@codemirror/lang-python": "^6.2.1",
		"@codemirror/language": "6.12.4",
		"@codemirror/legacy-modes": "^6.5.4",
		"@codemirror/state": "^6.7.6",
		"@codemirror/theme-one-dark": "^6.1.3",
		"@codemirror/view": "^6.43.13",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@tailwindcss/vite": "^4.3.0",
		"@tanstack/table-core": "^8.21.3",
		"clsx": "^2.1.1",
		"codemirror": "^6.0.2",
		"dompurify": "^3.4.16",
		"marked": "^18.0.14",
		"openapi-fetch": "^0.17.0",
		"tailwind-merge": "^3.6.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.1",
		"@lucide/svelte": "^1.48.0",
		"@shadcn/lint": "^0.2.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^25.9.0",
		"@typescript-eslint/parser": "^8.71.0",
		"bits-ui": "^2.19.3",
		"eslint": "^10.4.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.1",
		"globals": "^17.6.0",
		"layerchart": "^2.5.0",
		"mode-watcher": "^1.1.0",
		"openapi-typescript": "^7.13.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.4.8",
		"svelte-sonner": "^1.2.1",
		"tailwind-variants": "^3.3.0",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.4",
		"vite": "^8.3.1"
	}
}
