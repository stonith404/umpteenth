# Cloudflare serves these headers with the static assets, see wrangler.jsonc
# Astro fingerprints everything under /_astro/, so a file there never changes and browsers may keep it for a year
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The fonts keep their names across releases, so browsers keep them for a week
/fonts/*
  Cache-Control: public, max-age=604800
