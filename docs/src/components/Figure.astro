---
// A card around a hand-drawn diagram, with the caption stating the one thing the drawing shows
import { card, figcaption } from './figure';

interface Props {
	caption?: string;
	// The narrowest the drawing may get before it scrolls sideways, so labels never shrink below reading size
	minWidth?: string;
}
const { caption, minWidth } = Astro.props;
---

<figure class={card} style={minWidth ? `--dg-min: ${minWidth}` : undefined}>
	{/* Wide drawings scroll inside the card on phones instead of shrinking their text */}
	<div class="overflow-x-auto p-5 [&>svg]:mx-auto [&>svg]:block [&>svg]:h-auto [&>svg]:w-full [&>svg]:max-w-[42.5rem] [&>svg]:min-w-[var(--dg-min,36rem)] [&>svg]:font-sans">
		<slot />
	</div>
	{caption && <figcaption class={figcaption}>{caption}</figcaption>}
</figure>
