];

// Lucide icon paths, drawn at 24 units like the app's icons
const icons = {
	tool: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
	bash: '<polyline points="4 17 10 11 4 5"/><line x1="12" x2="20" y1="19" y2="19"/>',
	file: '<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 12.5 8 15l2 2.5"/><path d="m14 12.5 2 2.5-2 2.5"/>',
	ump: '<rect width="18" height="18" x="3" y="3" rx="2"/><path d="m7 11 2-2-2-2"/><path d="M11 13h4"/>',
	verify: '<circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/>',
	note: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>',
	pr: '<circle cx="18" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><path d="M13 6h3a2 2 0 0 1 2 2v7"/><line x1="6" x2="6" y1="9" y2="21"/>',
	verdict: '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>',
	commits: '<circle cx="12" cy="12" r="3"/><line x1="3" x2="9" y1="12" y2="12"/><line x1="15" x2="21" y1="12" y2="12"/>',
	digest: '<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>',
	box: '<path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/>',
	cross: '<circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/>'
};

// Turns backticks in the mock copy into code spans, escaping the rest since it lands in set:html
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const md = (s: string) => esc(s).replace(/`([^`]+)`/g, '<code>$1</code>');

// Each step rises this long after the previous one, and the status flips to Succeeded once the result has risen
const STEP_MS = 420;
const settleMs = (steps: Step[]) => `${steps.length * STEP_MS + 580}ms`;
---

<div class="uc" data-uc>
	{
		useCases.map((u, i) => (
			<>
				<div class:list={['uc-item', { active: i === 0 }]} style={`--row: ${i + 1}`}>
					<span class="uc-rail" aria-hidden="true" />
					<p class="uc-trigger">
						{u.trigger} · {u.when}
					</p>
					<h3 class="uc-name">
						<button type="button" id={`uc-tab-${i}`} aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`uc-run-${i}`}>
							{u.title}
						</button>
					</h3>
					<div class="uc-body">
						<div>
							<p>{u.text}</p>
						</div>
					</div>
				</div>

				<div
					class:list={['uc-panel', { active: i === 0 }]}
					id={`uc-run-${i}`}
					role="region"
					aria-labelledby={`uc-tab-${i}`}
					inert={i !== 0}
					style={`--settle: ${settleMs(u.run.steps)}; --step: ${STEP_MS}ms`}
				>
					<div class="win">
						<div class="win-head">
							<span class="job">
								{u.run.job}
								<span class="num">#{u.run.number}</span>
							</span>
							<span class="badges">
								<span class:list={['mode', u.run.mode.toLowerCase()]}>{u.run.mode}</span>
								<span class="status">
									<span class="badge live">
										<span class="ping" aria-hidden="true" />
										Running
									</span>
									<span class="badge done">
										<svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.verify} />
										Succeeded
									</span>
								</span>
							</span>
						</div>

						<div class="win-input">
							<span class="input-kind">{u.run.input.kind}</span>
							<code class="input-value">{u.run.input.value}</code>
							<span class="win-meta">
								{u.run.duration} · {u.run.cost}
							</span>
						</div>

						<ol class="steps">
							{u.run.steps.map((s, n) => (
								<li class:list={['step', 'anim', s.kind]} style={`--i: ${n}`}>
									<svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons[s.kind]} />
									<span class="call">
										<span class="name">{s.name}</span>
										{s.arg && <span class="arg">{s.arg}</span>}
									</span>
									<span class="res">{s.result}</span>
									<span class="at">{s.at}</span>
								</li>
							))}
						</ol>

						<div class="result anim" style={`--i: ${u.run.steps.length}`}>
							<p class="result-label">
								<svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons[u.run.result.kind]} />
								{u.run.result.label}
							</p>
							<p class="result-title">{u.run.result.title}</p>
							{'meta' in u.run.result && <p class="result-meta">{u.run.result.meta}</p>}

							{u.run.result.kind === 'note' &&
								u.run.result.body.map((line) => <p class="result-text" set:html={md(line)} />)}

							{u.run.result.kind === 'pr' && (
								<div class="diff">
									<p class="diff-file">{u.run.result.file}</p>
									<p class="del">{u.run.result.removed}</p>
									<p class="add">{u.run.result.added}</p>
								</div>
							)}

							{u.run.result.kind === 'verdict' && (
								<>
									<p class="verdict">
										<svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.cross} />
										{u.run.result.verdict}
									</p>
									<ul class="reasons">
										{u.run.result.reasons.map((r) => (
											<li set:html={md(r)} />
										))}
									</ul>
								</>
							)}

							{u.run.result.kind === 'commits' && (
								<>
									<ul class="commits">
										{u.run.result.commits.map((c) => (
											<li>
												<code>{c.sha}</code>
												{c.message}
											</li>
										))}
									</ul>
									<p class="check">
										<svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.verify} />
										{u.run.result.check}
									</p>
								</>
							)}

							{u.run.result.kind === 'digest' &&
								u.run.result.groups.map((g) => (
									<div class="group">
										<p class="group-heading">{g.heading}</p>
										<ul>
											{g.items.map((item) => (
												<li>
													<span class="source">{item.source}</span>
													{item.text}
												</li>
											))}
										</ul>
									</div>
								))}
						</div>

						<div class="win-foot anim" style={`--i: ${u.run.steps.length + 1}`}>
							<span class="foot-sandbox">
								<svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.box} />
								Sandbox destroyed
							</span>
							<span>{u.run.playbook}</span>
						</div>
					</div>
				</div>
			</>
		))
	}
</div>

<script>
	// Show one example run at a time, and on wide screens step through them until the reader picks one
	const root = document.querySelector<HTMLElement>('[data-uc]');
	if (root) {
		const items = [...root.querySelectorAll<HTMLElement>('.uc-item')];
		const panels = [...root.querySelectorAll<HTMLElement>('.uc-panel')];
		let current = 0;

		// Open one item and its run, and take the others out of the tab order
		const select = (index: number) => {
			items.forEach((item, n) => {
				item.classList.toggle('active', n === index);
				item.querySelector('button')?.setAttribute('aria-expanded', String(n === index));
			});
			panels.forEach((panel, n) => {
				panel.classList.toggle('active', n === index);
				panel.inert = n !== index;
			});
			current = index;
		};

		// The stylesheet keeps the steps hidden until the section scrolls into view, but only once this script runs
		root.dataset.js = '';

		// A click hands control to the reader, so the auto-advance stops for good
		items.forEach((item, n) =>
			item.querySelector('button')?.addEventListener('click', () => {
				root.classList.add('manual');
				select(n);
			})
		);

		// The active item's rail fills over a few seconds, and a full rail moves on to the next job
		root.addEventListener('animationend', (event) => {
			if (!(event.target as HTMLElement).classList.contains('uc-rail') || root.classList.contains('manual')) return;
			select((current + 1) % items.length);
		});

		// Replay the first run once the section is on screen, and pause the rail while it is off screen
		new IntersectionObserver(
			([entry]) => {
				root.classList.toggle('in-view', entry.isIntersecting);
				if (entry.isIntersecting) root.classList.add('seen');
			},
			{ threshold: 0.3 }
		).observe(root);
	}
</script>

<style>
	/* Picker on the left, run viewer on the right, and on phones each run opens under its job */
	.uc {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		margin-top: 2.5rem;
	}
	@media (min-width: 60rem) {
		.uc {
			grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
			/* The last row absorbs the height the run viewer has beyond the picker, so the jobs stay packed at the top */
			grid-template-rows: repeat(4, auto) 1fr;
			column-gap: 3.5rem;
		}
		.uc-item {
			grid-column: 1;
			grid-row: var(--row);
			align-self: start;
		}
		.uc-panel {
			grid-column: 2;
			grid-row: 1 / -1;
		}
		/* All runs share one cell, so switching jobs never changes the section's height */
		.uc-panel:not(.active) {
			visibility: hidden;
		}
	}
	@media (max-width: 59.999rem) {
		.uc-panel:not(.active) {
			display: none;
		}
		.uc-panel {
			padding: 0.25rem 0 1.25rem 1.25rem;
		}
	}

	/* Picker */
	.uc-item {
		position: relative;
		padding: 0.875rem 0 0.875rem 1.25rem;
	}
	.uc-item::before,
	.uc-rail {
		content: '';
		position: absolute;
		inset: 0 auto 0 0;
		width: 2px;
	}
	.uc-item::before {
		background: var(--sl-color-gray-5);
	}
	.uc-rail {
		background: var(--brand);
		transform-origin: top;
		transform: scaleY(0);
	}
	.uc-item.active .uc-rail {
		transform: none;
	}
	:global([data-theme='light']) .uc-rail {
		background: var(--sl-color-white);
	}
	.uc-trigger {
		margin: 0 0 0.25rem;
		font-family: var(--font-mono);
		font-size: var(--text-2xs);
		color: var(--sl-color-gray-3);
	}
	.uc-name {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.3125rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		line-height: 1.25;
	}
	.uc-name button {
		all: unset;
		cursor: pointer;
		color: var(--sl-color-gray-3);
		transition: color 150ms ease;
	}
	/* The whole item is the click target, not only the title */
	.uc-name button::after {
		content: '';
		position: absolute;
		inset: 0;
	}
	.uc-item:hover .uc-name button,
	.uc-item.active .uc-name button {
		color: var(--sl-color-white);
	}
	.uc-name button:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 4px;
		border-radius: 0.25rem;
	}
	.uc-body {
		display: grid;
		grid-template-rows: 0fr;
		transition: grid-template-rows 300ms ease;
	}
	.uc-body > div {
		min-height: 0;
