---
// Example jobs as a picker beside a run viewer that replays a made-up run of the picked job, step by step, the way the app's run timeline shows it

type Step = {
  // tool is an MCP tool, bash and file are the agent's own tools, ump is a call from a scripted run, verify is the check after a script
  kind: "tool" | "bash" | "file" | "ump" | "verify";
  name: string;
  arg?: string;
  result: string;
  at: string;
};
type Result =
  | { kind: "note"; label: string; title: string; body: string[] }
  | {
      kind: "pr";
      label: string;
      title: string;
      meta: string;
      file: string;
      removed: string;
      added: string;
    }
  | {
      kind: "verdict";
      label: string;
      title: string;
      meta: string;
      verdict: string;
      reasons: string[];
    }
  | {
      kind: "commits";
      label: string;
      title: string;
      meta: string;
      commits: { sha: string; message: string }[];
      check: string;
    }
  | {
      kind: "digest";
      label: string;
      title: string;
      groups: { heading: string; items: { source: string; text: string }[] }[];
    };
type UseCase = {
  trigger: string;
  when: string;
  title: string;
  text: string;
  run: {
    job: string;
    input: { kind: string; value: string };
    steps: Step[];
    result: Result;
  };
};

const useCases: UseCase[] = [
  {
    trigger: "Webhook",
    when: "On alert",
    title: "Alert triage",
    text: "An alert fires at 3 a.m. By the time whoever is on call opens their laptop, the agent has pulled the service's logs from Loki, matched them against the last deploy and attached its analysis to the alert.",
