    text: "Keeping docs up to date is hard (looking at you AWS). After a release the agent goes through all the new commits, finds the pages that don't match the code anymore and opens a pull request to fix them.",
    run: {
      job: "Docs sync",
      input: { kind: "Webhook", value: '{"tag": "v2.4.0"}' },
      steps: [
