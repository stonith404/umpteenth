        check: "214 tests passed",
      },
    },
  },
  {
    title: "Monday catch-up",
    text: "On Monday morning the agent goes through your Teams chats, Outlook mails and GitHub notifications from last week and sends you a short digest with the stuff that is actually important.",
    run: {
      job: "Monday catch-up",
      input: { kind: "Schedule", value: "0 8 * * 1" },
      steps: [
        {
          kind: "ump",
          name: "ump",
          arg: "mcp call teams list_chats",
          result: "38 threads",
          at: "+1s",
        },
        {
          kind: "ump",
          name: "ump",
          arg: "mcp call outlook list_messages",
          result: "61 emails",
          at: "+2s",
        },
        {
          kind: "ump",
          name: "ump",
          arg: "mcp call github list_notifications",
          result: "24 notifications",
          at: "+3s",
        },
        {
          kind: "ump",
          name: "ump",
          arg: "llm --model utility",
          result: "digest",
          at: "+9s",
        },
        {
          kind: "ump",
          name: "ump",
          arg: "mcp call outlook send_mail",
          result: "sent",
          at: "+10s",
        },
        {
          kind: "verify",
          name: "Verification passed",
          result: "3 of 3 checks",
          at: "+12s",
        },
      ],
      result: {
        kind: "digest",
        label: "Email to you",
        title: "Your Monday catch-up",
        groups: [
          {
            heading: "Waiting on you",
            items: [
              {
                source: "Teams",
                text: "Priya asked in #platform whether the Q3 migration can slip a week.",
