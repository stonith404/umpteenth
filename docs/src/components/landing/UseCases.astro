  },
  {
    title: "Fight AI slop in security reports",
    text: "GitHub security advisories are probably the worst place on the internet in terms of AI slop. Let the agent try to reproduce and analyze the reports first, before you waste your time on them.",
    run: {
      job: "Security report check",
      input: { kind: "Schedule", value: "0 * * * *" },
      steps: [
        {
          kind: "tool",
          name: "github__list_security_advisories",
          arg: "state=triage",
          result: "1 new report",
          at: "+2s",
        },
        {
          kind: "file",
          name: "read_file",
          arg: "report.md",
          result: "2,113 words",
          at: "+4s",
        },
        {
          kind: "bash",
          name: "bash",
          arg: "git log -S parse_header_ex --oneline",
          result: "no commits",
          at: "+9s",
        },
        {
          kind: "bash",
          name: "bash",
          arg: "gcc poc.c -lparse -o poc",
          result: "undefined reference",
          at: "+17s",
        },
        {
          kind: "tool",
          name: "slack__post_message",
          arg: "#security",
          result: "sent",
          at: "+38s",
