				check: '214 tests passed'
			}
		}
	},
	{
		trigger: 'Schedule',
		when: 'Mondays at 8:00',
		title: 'The Monday catch-up',
		text: "Before you open anything on Monday, the agent goes through last week's Teams chats, Outlook threads and GitHub notifications. You get one digest of what's waiting on you: questions you haven't answered, reviews you owe and decisions made while you were out.",
		run: {
			job: 'Monday catch-up',
			number: 31,
			mode: 'Scripted',
			input: { kind: 'Schedule', value: '0 8 * * 1' },
			duration: '12s',
			cost: '$0.004',
			playbook: 'Playbook v14, unchanged',
			steps: [
				{ kind: 'ump', name: 'ump', arg: 'mcp call teams list_chats', result: '38 threads', at: '+1s' },
				{ kind: 'ump', name: 'ump', arg: 'mcp call outlook list_messages', result: '61 emails', at: '+2s' },
				{ kind: 'ump', name: 'ump', arg: 'mcp call github list_notifications', result: '24 notifications', at: '+3s' },
				{ kind: 'ump', name: 'ump', arg: 'llm --model utility', result: 'digest', at: '+9s' },
				{ kind: 'ump', name: 'ump', arg: 'mcp call outlook send_mail', result: 'sent', at: '+10s' },
				{ kind: 'verify', name: 'Verification passed', result: '3 of 3 checks', at: '+12s' }
			],
			result: {
				kind: 'digest',
				label: 'Email to you',
				title: 'Your Monday catch-up',
				groups: [
					{
						heading: 'Waiting on you',
						items: [
							{ source: 'Teams', text: 'Priya asked in #platform whether the Q3 migration can slip a week.' },
							{ source: 'Outlook', text: 'The hosting contract needs your signature by Wednesday.' },
							{ source: 'GitHub', text: 'Two review requests on acme/api, #881 and #884.' }
						]
					},
					{
						heading: 'Decided while you were out',
						items: [{ source: 'Teams', text: "The web team moved Thursday's release to Friday." }]
					}
				]
			}
