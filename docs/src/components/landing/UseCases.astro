    run: {
      job: "Monday catch-up",
      input: { kind: "Schedule", value: "0 8 * * 1" },
      steps: [
        {
          kind: "ump",
          name: "ump",
          arg: "mcp call teams list_chats",
          result: "38 threads",
          at: "+1s",
        },
        {
          kind: "ump",
          name: "ump",
          arg: "mcp call outlook list_messages",
          result: "61 emails",
          at: "+2s",
        },
        {
          kind: "ump",
          name: "ump",
          arg: "mcp call github list_notifications",
          result: "24 notifications",
          at: "+3s",
        },
        {
          kind: "ump",
          name: "ump",
          arg: "llm --model utility",
          result: "digest",
          at: "+9s",
        },
        {
          kind: "ump",
          name: "ump",
          arg: "mcp call outlook send_mail",
          result: "sent",
          at: "+10s",
        },
        {
          kind: "verify",
          name: "Verification passed",
          result: "3 of 3 checks",
