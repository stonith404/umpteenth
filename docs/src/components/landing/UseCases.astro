---
// Example jobs as a picker beside a run viewer that replays a made-up run of the picked job, step by step, the way the app's run timeline shows it

type Step = {
	// tool is an MCP tool, bash and file are the agent's own tools, ump is a call from a scripted run, verify is the check after a script
	kind: 'tool' | 'bash' | 'file' | 'ump' | 'verify';
	name: string;
	arg?: string;
	result: string;
	at: string;
};
type Result =
	| { kind: 'note'; label: string; title: string; body: string[] }
	| { kind: 'pr'; label: string; title: string; meta: string; file: string; removed: string; added: string }
	| { kind: 'verdict'; label: string; title: string; meta: string; verdict: string; reasons: string[] }
	| { kind: 'commits'; label: string; title: string; meta: string; commits: { sha: string; message: string }[]; check: string }
	| { kind: 'digest'; label: string; title: string; groups: { heading: string; items: { source: string; text: string }[] }[] };
type UseCase = {
	trigger: string;
	when: string;
	title: string;
	text: string;
	run: {
		job: string;
		number: number;
		mode: 'Explore' | 'Assisted' | 'Scripted';
		input: { kind: string; value: string };
		duration: string;
		cost: string;
		steps: Step[];
		result: Result;
		// What reflection did with the playbook after the run
		playbook: string;
	};
};

const useCases: UseCase[] = [
	{
		trigger: 'Webhook',
		when: 'On alert',
		title: 'Alert triage',
		text: "An alert fires at 3 a.m. By the time whoever is on call opens their laptop, the agent has pulled the service's logs from Loki, matched them against the last deploy and attached its analysis to the alert.",
		run: {
			job: 'Checkout alert triage',
			number: 214,
			mode: 'Assisted',
			input: { kind: 'Webhook', value: '{"alertname": "HighErrorRate", "service": "checkout"}' },
			duration: '50s',
			cost: '$0.07',
			playbook: 'Reflection saved playbook v9',
			steps: [
				{ kind: 'tool', name: 'loki__query_range', arg: '{app="checkout"} |= "error"', result: '1,284 lines', at: '+3s' },
				{ kind: 'bash', name: 'bash', arg: 'git log --since="3 hours ago" --oneline', result: '2 commits', at: '+9s' },
				{ kind: 'file', name: 'read_file', arg: 'runbooks/checkout.md', result: '86 lines', at: '+14s' },
				{ kind: 'tool', name: 'loki__query_range', arg: '{app="checkout"} |= "too many connections"', result: '94% of errors', at: '+26s' },
				{ kind: 'tool', name: 'oncall__add_note', arg: 'HighErrorRate', result: 'added', at: '+50s' }
			],
			result: {
				kind: 'note',
				label: 'Note on the alert',
				title: 'HighErrorRate · checkout',
				body: [
					'Errors started at 02:51, four minutes after the deploy of #1432, which lowered the database pool to 10.',
					'94% of them are `pq: too many connections`. Rolling back #1432 or raising the pool size clears them.'
				]
			}
		}
	},
	{
		trigger: 'Webhook',
		when: 'On release',
		title: 'Docs that keep up',
		text: 'You publish a release. The agent goes through every commit since the last one, finds the doc pages that no longer match the code and opens a pull request that fixes them.',
		run: {
			job: 'Docs sync',
			number: 37,
			mode: 'Assisted',
			input: { kind: 'Webhook', value: '{"tag": "v2.4.0"}' },
			duration: '1m 03s',
			cost: '$0.19',
			playbook: 'Reflection saved playbook v4',
			steps: [
				{ kind: 'bash', name: 'bash', arg: 'git log v2.3.0..v2.4.0 --oneline', result: '41 commits', at: '+2s' },
				{ kind: 'bash', name: 'bash', arg: 'grep -rln "SESSION_TTL" docs/', result: '2 pages', at: '+11s' },
				{ kind: 'file', name: 'edit_file', arg: 'docs/configuration.md', result: '+4 −3', at: '+34s' },
				{ kind: 'file', name: 'edit_file', arg: 'docs/upgrading.md', result: '+12', at: '+47s' },
				{ kind: 'tool', name: 'github__create_pull_request', arg: 'acme/web', result: '#1455', at: '+1m 03s' }
			],
			result: {
				kind: 'pr',
				label: 'Pull request',
				title: 'Update the docs for v2.4.0',
				meta: 'acme/web #1455 · 2 files changed',
				file: 'docs/configuration.md',
				removed: 'Set `SESSION_TTL` to the session length in hours.',
				added: 'Set `session.ttl` to a duration, such as `12h`.'
			}
		}
	},
	{
		trigger: 'Schedule',
		when: 'Every hour',
		title: 'Security reports, slop-filtered',
		text: 'A new vulnerability report arrives: critical severity, 2,000 words, a function your code never had and "I hope this helps!" at the end. The agent runs the proof of concept in a sandbox before you read a word. Real findings reach you with a working reproduction, and the rest don\'t cost you an afternoon.',
		run: {
			job: 'Security report check',
			number: 326,
			mode: 'Assisted',
			input: { kind: 'Schedule', value: '0 * * * *' },
			duration: '38s',
			cost: '$0.05',
			playbook: 'Playbook v6, unchanged',
			steps: [
				{ kind: 'tool', name: 'github__list_security_advisories', arg: 'state=triage', result: '1 new report', at: '+2s' },
				{ kind: 'file', name: 'read_file', arg: 'report.md', result: '2,113 words', at: '+4s' },
				{ kind: 'bash', name: 'bash', arg: 'git log -S parse_header_ex --oneline', result: 'no commits', at: '+9s' },
				{ kind: 'bash', name: 'bash', arg: 'gcc poc.c -lparse -o poc', result: 'undefined reference', at: '+17s' },
				{ kind: 'tool', name: 'slack__post_message', arg: '#security', result: 'sent', at: '+38s' }
			],
			result: {
				kind: 'verdict',
				label: 'Posted to #security',
				title: 'Heap overflow in parse_header_ex()',
				meta: 'Reported as critical · 2,113 words',
				verdict: 'Not reproduced',
				reasons: [
					'`parse_header_ex()` appears nowhere in the code or its history.',
					'The proof of concept fails to build against any release.'
				]
			}
		}
	},
	{
		trigger: 'Schedule',
		when: 'Every night',
		title: 'Major upgrades, merged at last',
		text: 'The major-version bump from Dependabot has been open since March because it breaks the build. Tonight the agent reads the migration guide, changes your code until the tests pass and pushes the fixes to the PR.',
		run: {
			job: 'Major upgrades',
			number: 12,
			mode: 'Assisted',
			input: { kind: 'Schedule', value: '0 2 * * *' },
			duration: '2m 12s',
			cost: '$0.31',
			playbook: 'Reflection saved playbook v3',
			steps: [
				{ kind: 'tool', name: 'github__list_pull_requests', arg: 'author:app/dependabot', result: 'vite 5 → 6', at: '+2s' },
				{ kind: 'bash', name: 'bash', arg: 'pnpm test', result: '12 failed', at: '+41s' },
				{ kind: 'bash', name: 'bash', arg: 'curl -s https://vite.dev/guide/migration', result: '48 KB', at: '+44s' },
				{ kind: 'file', name: 'edit_file', arg: 'vite.config.ts', result: '+6 −2', at: '+1m 18s' },
				{ kind: 'bash', name: 'bash', arg: 'pnpm test', result: '214 passed', at: '+2m 07s' },
				{ kind: 'bash', name: 'bash', arg: 'git push', result: '2 commits', at: '+2m 12s' }
			],
			result: {
				kind: 'commits',
				label: 'Pushed to the pull request',
				title: 'Bump vite from 5.4.11 to 6.0.3',
				meta: 'acme/web #412 · open since March',
				commits: [
					{ sha: 'a41c9e2', message: 'Switch Sass to the modern compiler API' },
					{ sha: '7be03fd', message: 'Set resolve.conditions for the Vite 6 defaults' }
