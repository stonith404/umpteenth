          arg: "vite.config.ts",
          result: "+6 −2",
          at: "+1m 18s",
        },
        {
          kind: "bash",
          name: "bash",
          arg: "pnpm test",
          result: "214 passed",
          at: "+2m 07s",
        },
        {
          kind: "bash",
          name: "bash",
