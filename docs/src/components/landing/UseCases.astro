    run: {
      job: "Major upgrades",
      input: { kind: "Schedule", value: "0 2 * * *" },
      steps: [
        {
          kind: "tool",
          name: "github__list_pull_requests",
          arg: "author:app/dependabot",
          result: "vite 5 → 6",
          at: "+2s",
        },
        {
          kind: "bash",
          name: "bash",
          arg: "pnpm test",
          result: "12 failed",
          at: "+41s",
        },
        {
          kind: "bash",
          name: "bash",
          arg: "curl -s https://vite.dev/guide/migration",
          result: "48 KB",
          at: "+44s",
        },
        {
          kind: "file",
          name: "edit_file",
          arg: "vite.config.ts",
          result: "+6 −2",
          at: "+1m 18s",
        },
        {
          kind: "bash",
          name: "bash",
          arg: "pnpm test",
          result: "214 passed",
          at: "+2m 07s",
        },
        {
          kind: "bash",
          name: "bash",
          arg: "git push",
          result: "2 commits",
          at: "+2m 12s",
        },
      ],
      result: {
        kind: "commits",
        label: "Pushed to the pull request",
        title: "Bump vite from 5.4.11 to 6.0.3",
        meta: "acme/web #412 · open since March",
        commits: [
          { sha: "a41c9e2", message: "Switch Sass to the modern compiler API" },
          {
            sha: "7be03fd",
            message: "Set resolve.conditions for the Vite 6 defaults",
          },
