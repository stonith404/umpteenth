---
// Example jobs as a picker beside a run viewer that replays a made-up run of the picked job, step by step, the way the app's run timeline shows it

type Step = {
  // tool is an MCP tool, bash and file are the agent's own tools, ump is a call from a scripted run, verify is the check after a script
  kind: "tool" | "bash" | "file" | "ump" | "verify";
  name: string;
  arg?: string;
  result: string;
  at: string;
};
type Result =
  | { kind: "note"; label: string; title: string; body: string[] }
  | {
      kind: "pr";
      label: string;
      title: string;
      meta: string;
      file: string;
      removed: string;
      added: string;
    }
  | {
      kind: "verdict";
      label: string;
      title: string;
      meta: string;
      verdict: string;
      reasons: string[];
    }
  | {
      kind: "commits";
      label: string;
      title: string;
      meta: string;
      commits: { sha: string; message: string }[];
      check: string;
    }
  | {
      kind: "digest";
      label: string;
      title: string;
      groups: { heading: string; items: { source: string; text: string }[] }[];
    };
type UseCase = {
  title: string;
  text: string;
  run: {
    job: string;
    input: { kind: string; value: string };
    steps: Step[];
    result: Result;
  };
};

const useCases: UseCase[] = [
  {
    title: "Alert triage",
    text: "An alert fires at 3 a.m. and the agent starts right away. It pulls the logs from Loki, checks them against the last deploy and adds what it found to the alert. So when you open your laptop, the annoying part is already done.",
    run: {
      job: "Checkout alert triage",
      input: {
        kind: "Webhook",
        value: '{"alertname": "HighErrorRate", "service": "checkout"}',
      },
      steps: [
        {
          kind: "tool",
          name: "loki__query_range",
          arg: '{app="checkout"} |= "error"',
          result: "1,284 lines",
          at: "+3s",
        },
        {
          kind: "bash",
          name: "bash",
          arg: 'git log --since="3 hours ago" --oneline',
          result: "2 commits",
          at: "+9s",
        },
        {
          kind: "file",
          name: "read_file",
          arg: "runbooks/checkout.md",
          result: "86 lines",
          at: "+14s",
        },
        {
          kind: "tool",
          name: "loki__query_range",
          arg: '{app="checkout"} |= "too many connections"',
          result: "94% of errors",
          at: "+26s",
        },
        {
          kind: "tool",
          name: "oncall__add_note",
          arg: "HighErrorRate",
          result: "added",
          at: "+50s",
        },
