// Turns backticks in the mock copy into code spans, escaping the rest since it lands in set:html
const esc = (s: string) =>
  s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const md = (s: string) => esc(s).replace(/`([^`]+)`/g, "<code>$1</code>");

// Each step rises this long after the previous one, and the status flips to Succeeded once the result has risen
const STEP_MS = 420;
const settleMs = (steps: Step[]) => `${steps.length * STEP_MS + 580}ms`;

// Icons at the app's 14px, filled in the current text color
const icon = "size-3.5 shrink-0 fill-current";

// The small rounded label that the mode, the status and the verdict share
const badge =
  "inline-flex h-5.5 items-center gap-1.5 rounded-md px-2 text-2xs font-medium";

// The lists in a result: the verdict's reasons, the pushed commits and the digest's items
const list = "m-0 mt-2.5 grid list-none gap-1.5 p-0 text-tile-soft";

// The code spans that md() writes through set:html can't carry classes, so their parent styles them
// They keep the text's size, unlike the input and the commit hashes, which are set a tenth smaller
const codeChips =
  "[&_code]:rounded-sm [&_code]:bg-[rgba(255,255,255,0.07)] [&_code]:px-1.25 [&_code]:py-0.25 [&_code]:font-mono [&_code]:text-paper";

// Replay: steps rise one after the other while the run shows Running, then the status settles
// Once the script runs, everything that rises stays hidden until the section first scrolls into view
const replay = [
  "motion-safe:group-[[data-js]:not(.seen)]/uc:opacity-0",
  "motion-safe:group-[.seen]/uc:group-[.active]/panel:animate-[rise_380ms_ease-out_calc(var(--i)_*_var(--step)_+_200ms)_both]",
];
const showWhileReplaying =
  "motion-safe:group-[.seen]/uc:group-[.active]/panel:animate-[show_var(--settle)_step-end]";
const hideWhileReplaying =
  "motion-safe:group-[.seen]/uc:group-[.active]/panel:animate-[hide_var(--settle)_step-end]";
---

{
  /* Picker on the left, run viewer on the right, and on phones each run opens under its job */
}
{
  /* On wide screens the last row absorbs the height the run viewer has beyond the picker, so the jobs stay packed at the top */
}
<div
  class:list={[
    "group/uc mt-10 grid grid-cols-[minmax(0,1fr)]",
    "min-[60rem]:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] min-[60rem]:grid-rows-[repeat(4,auto)_1fr] min-[60rem]:gap-x-14",
  ]}
  data-uc
>
  {
    useCases.map((u, i) => (
      <>
        {/* Picker */}
        <div
          class:list={[
            "group/item relative py-3.5 pl-5",
            "before:absolute before:inset-y-0 before:left-0 before:w-0.5 before:bg-gray-5",
            "min-[60rem]:col-1 min-[60rem]:row-(--row) min-[60rem]:self-start",
            { active: i === 0 },
          ]}
          style={`--row: ${i + 1}`}
          data-uc-item
        >
          {/* Auto-advance: on wide screens the active rail fills, pausing while the reader hovers, focuses or scrolls away */}
          {/* The pause has to be important to hold against the animation shorthand, which resets the play state */}
          <span
            class:list={[
              "absolute inset-y-0 left-0 w-0.5 origin-top bg-brand [transform:scaleY(0)] light:bg-fg",
              "group-[.active]/item:transform-none",
              "motion-safe:min-[60rem]:group-[[data-js]:not(.manual)]/uc:group-[.active]/item:animate-fill-down",
              "group-[:is(:hover,:focus-within,:not(.in-view))]/uc:[animation-play-state:paused]!",
            ]}
            aria-hidden="true"
            data-uc-rail
          />
          {/* The button drops every browser style, which Tailwind sorts after the other utilities, so it inherits its color and cursor from the heading */}
          <h3
            class:list={[
              "m-0 font-display text-[1.3125rem] leading-tight font-semibold tracking-[-0.01em]",
              "cursor-pointer text-gray-3 transition-[color] duration-150 ease-[ease]",
              "group-[:hover]/item:text-fg group-[.active]/item:text-fg",
            ]}
          >
            {/* The button's ::after stretches over the whole item, so the item is the click target, not only the title */}
            <button
              type="button"
              class:list={[
                "[all:unset] after:absolute after:inset-0",
                "focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent",
              ]}
              id={`uc-tab-${i}`}
              aria-expanded={i === 0 ? "true" : "false"}
              aria-controls={`uc-run-${i}`}
            >
              {u.title}
            </button>
          </h3>

          {/* The description opens by growing its row from 0fr to 1fr, and stays out of the accessibility tree while closed */}
          <div class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-[ease] group-[.active]/item:grid-rows-[1fr]">
            <div class="invisible min-h-0 overflow-hidden transition-[visibility] delay-300 duration-0 ease-[ease] group-[.active]/item:visible group-[.active]/item:delay-0">
              <p class="m-0 pt-2 text-sm leading-[1.55] text-pretty text-gray-3">
                {u.text}
              </p>
            </div>
          </div>
        </div>

        {/* On wide screens all runs share one cell, so switching jobs never changes the section's height */}
        <div
          class:list={[
            "group/panel",
            "min-[60rem]:col-2 min-[60rem]:row-span-full min-[60rem]:not-[.active]:invisible",
            "max-[60rem]:pt-1 max-[60rem]:pb-5 max-[60rem]:pl-5 max-[60rem]:not-[.active]:hidden",
            { active: i === 0 },
          ]}
          id={`uc-run-${i}`}
          role="region"
          aria-labelledby={`uc-tab-${i}`}
          inert={i !== 0}
          style={`--settle: ${settleMs(u.run.steps)}; --step: ${STEP_MS}ms`}
          data-uc-panel
        >
          {/* The run viewer is always dark like the hero's run list, since it stands for the app */}
          <div
            class:list={[
              "flex flex-col overflow-hidden text-sm",
              "rounded-xl border border-[rgba(255,255,255,0.08)] bg-tile text-paper",
              "[box-shadow:0_1px_2px_rgba(0,0,0,0.3),0_24px_48px_-24px_rgba(0,0,0,0.5)]",
            ]}
          >
            <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-b border-[rgba(255,255,255,0.08)] px-4.5 py-3.5">
              <span class="font-semibold">{u.run.job}</span>
              <span class="inline-grid">
                <span
                  class:list={[
                    badge,
                    "col-start-1 row-start-1 justify-self-end whitespace-nowrap",
                    "invisible bg-[rgba(59,130,246,0.2)] text-[#93c5fd]",
                    showWhileReplaying,
                  ]}
                >
                  <span
                    class="size-1.5 animate-ping-blue rounded-full bg-[#3b82f6]"
                    aria-hidden="true"
                  />
                  Running
                </span>
                <span
                  class:list={[
                    badge,
                    "col-start-1 row-start-1 justify-self-end whitespace-nowrap",
                    "bg-[rgba(16,185,129,0.15)] text-[#6ee7b7]",
                    hideWhileReplaying,
                  ]}
                >
                  <svg
                    class={icon}
                    viewBox="0 0 256 256"
                    aria-hidden="true"
                    set:html={icons.verify}
                  />
                  Succeeded
                </span>
              </span>
            </div>

            <div class="flex items-baseline gap-3 border-b border-[rgba(255,255,255,0.06)] bg-[rgba(255,255,255,0.02)] px-4.5 py-2.5 text-xs">
              <span class="text-tile-muted">{u.run.input.kind}</span>
              <code class="min-w-0 truncate font-mono text-[0.9em] text-tile-soft">
                {u.run.input.value}
              </code>
            </div>

            {/* Steps, laid out like the app's timeline rows, which drop the time column on phones */}
            <ol class="m-0 list-none px-0 py-2">
              {u.run.steps.map((s, n) => (
                <li
                  class:list={[
                    "grid grid-cols-[14px_minmax(0,1fr)_auto_3.75rem] items-center gap-3 px-4.5 py-1.5 text-xs",
                    "[@media(max-width:30rem)]:grid-cols-[14px_minmax(0,1fr)_auto]",
                    replay,
                  ]}
                  style={`--i: ${n}`}
                >
                  <svg
                    class:list={[
                      icon,
                      s.kind === "verify"
                        ? "text-[#34d399]"
                        : "text-tile-muted",
                    ]}
                    viewBox="0 0 256 256"
                    aria-hidden="true"
                    set:html={icons[s.kind]}
                  />
                  <span
                    class:list={[
                      "truncate",
                      s.kind === "verify" ? "font-medium" : "font-mono",
                    ]}
                  >
                    {s.name}
                    {s.arg && <span class="ml-2 text-tile-muted">{s.arg}</span>}
                  </span>
                  <span class="whitespace-nowrap text-tile-subtle">
                    {s.result}
                  </span>
                  <span class="text-right font-mono whitespace-nowrap text-tile-muted [@media(max-width:30rem)]:hidden">
                    {s.at}
                  </span>
                </li>
              ))}
            </ol>

            {/* The result is what lands where the reader looks: a note, a pull request, a message or an email */}
            <div
              class:list={[
                "mx-4.5 mt-1 mb-4.5 rounded-lg border border-[rgba(255,255,255,0.08)] bg-[rgba(255,255,255,0.03)] px-4 py-3.5",
                replay,
              ]}
              style={`--i: ${u.run.steps.length}`}
            >
              <p class="m-0 mb-2 flex items-center gap-2 text-2xs font-medium text-brand">
                <svg
                  class={icon}
                  viewBox="0 0 256 256"
                  aria-hidden="true"
                  set:html={icons[u.run.result.kind]}
                />
                {u.run.result.label}
              </p>
              <p class="m-0 font-semibold">{u.run.result.title}</p>
              {"meta" in u.run.result && (
                <p class="m-0 font-mono text-2xs text-tile-muted">
                  {u.run.result.meta}
                </p>
              )}

              {u.run.result.kind === "note" &&
                u.run.result.body.map((line) => (
                  <p
                    class:list={[
                      "m-0 mt-2 text-pretty text-tile-soft",
                      codeChips,
                    ]}
                    set:html={md(line)}
                  />
                ))}

              {u.run.result.kind === "pr" && (
                <div class="mt-3 overflow-hidden rounded-md border border-[rgba(255,255,255,0.06)] font-mono text-2xs">
                  <p class="m-0 border-b border-[rgba(255,255,255,0.06)] bg-[rgba(255,255,255,0.03)] px-3 py-1.25 text-tile-muted">
                    {u.run.result.file}
                  </p>
                  <p class="m-0 bg-[rgba(239,68,68,0.12)] px-3 py-1.25 text-[#fca5a5] before:content-['−_']">
                    {u.run.result.removed}
                  </p>
                  <p class="m-0 bg-[rgba(16,185,129,0.12)] px-3 py-1.25 text-[#6ee7b7] before:content-['+_']">
                    {u.run.result.added}
                  </p>
                </div>
              )}

              {u.run.result.kind === "verdict" && (
                <>
                  <p
                    class:list={[
                      badge,
                      "m-0 mt-3 bg-[rgba(255,255,255,0.08)] text-tile-soft",
                    ]}
                  >
                    <svg
                      class={icon}
                      viewBox="0 0 256 256"
                      aria-hidden="true"
                      set:html={icons.cross}
                    />
                    {u.run.result.verdict}
                  </p>
                  <ul class:list={[list, codeChips]}>
                    {u.run.result.reasons.map((r) => (
                      <li
                        class="relative pl-4 before:absolute before:top-[0.55em] before:left-0 before:size-[5px] before:bg-tile-muted"
                        set:html={md(r)}
                      />
                    ))}
                  </ul>
                </>
              )}

              {u.run.result.kind === "commits" && (
                <>
                  <ul class={list}>
                    {u.run.result.commits.map((c) => (
                      <li class="flex gap-2.5">
                        <code class="font-mono text-[0.9em] text-tile-muted">
                          {c.sha}
                        </code>
                        {c.message}
                      </li>
                    ))}
                  </ul>
                  <p class="m-0 mt-3 flex items-center gap-2 text-xs text-[#6ee7b7]">
                    <svg
                      class={icon}
                      viewBox="0 0 256 256"
                      aria-hidden="true"
                      set:html={icons.verify}
                    />
                    {u.run.result.check}
                  </p>
                </>
              )}

              {u.run.result.kind === "digest" &&
                u.run.result.groups.map((g, gi) => (
                  <div class:list={{ "mt-3.5": gi > 0 }}>
                    <p class="m-0 mt-2.5 text-xs font-medium text-tile-muted">
                      {g.heading}
                    </p>
                    <ul class={list}>
                      {g.items.map((item) => (
                        <li class="flex items-baseline gap-2.5">
                          <span class="w-15 shrink-0 font-mono text-2xs text-tile-muted">
                            {item.source}
                          </span>
                          {item.text}
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
            </div>
          </div>
        </div>
      </>
    ))
  }
</div>

<script>
  // Show one example run at a time, and on wide screens step through them until the reader picks one
  const root = document.querySelector<HTMLElement>("[data-uc]");
  if (root) {
    const items = [...root.querySelectorAll<HTMLElement>("[data-uc-item]")];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-uc-panel]")];
    let current = 0;

    // Open one item and its run, and take the others out of the tab order
    const select = (index: number) => {
      items.forEach((item, n) => {
        item.classList.toggle("active", n === index);
        item
          .querySelector("button")
          ?.setAttribute("aria-expanded", String(n === index));
      });
      panels.forEach((panel, n) => {
        panel.classList.toggle("active", n === index);
        panel.inert = n !== index;
      });
      current = index;
    };

    // The markup keeps the steps hidden until the section scrolls into view, but only once this script runs
    root.dataset.js = "";

    // A click hands control to the reader, so the auto-advance stops for good
    items.forEach((item, n) =>
      item.querySelector("button")?.addEventListener("click", () => {
        root.classList.add("manual");
        select(n);
      }),
    );

    // The active item's rail fills over a few seconds, and a full rail moves on to the next job
    root.addEventListener("animationend", (event) => {
      if (
        !(event.target as HTMLElement).hasAttribute("data-uc-rail") ||
        root.classList.contains("manual")
      )
        return;
      select((current + 1) % items.length);
    });

    // Replay the first run once the section is on screen, and pause the rail while it is off screen
    new IntersectionObserver(
      ([entry]) => {
        root.classList.toggle("in-view", entry.isIntersecting);
        if (entry.isIntersecting) root.classList.add("seen");
      },
      { threshold: 0.3 },
    ).observe(root);
  }
</script>
