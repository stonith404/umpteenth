---
// A short footer for the landing page, the docs pages keep Starlight's own
import Mark from './Mark.astro';
const year = new Date().getFullYear();
---

<footer class="footer">
	<div class="wrap row">
		<div class="left">
			<Mark size={24} class="mark" />
			<span>Umpteenth is open source. Run it on your own hardware, with your own models.</span>
		</div>
		<nav class="links" aria-label="Footer">
			<a href="/getting-started/introduction/">Docs</a>
			<a href="/getting-started/installation/">Install</a>
			<a href="/reference/api/">API</a>
			<a href="https://github.com/stonith404/umpteenth">GitHub</a>
		</nav>
	</div>
	<div class="wrap fine">© {year} Umpteenth</div>
</footer>

<style>
	.footer {
		border-top: 1px solid var(--sl-color-hairline);
		padding-block: 2rem 2.5rem;
		font-size: var(--text-sm);
		color: var(--sl-color-gray-3);
	}
	.wrap {
		max-width: 72rem;
		margin-inline: auto;
		padding-inline: 1.5rem;
	}
	.row {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: 1rem 2rem;
	}
	.left {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		color: var(--sl-color-gray-2);
	}
	.left :global(.mark) {
		color: var(--sl-color-white);
		flex-shrink: 0;
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25rem;
	}
	.links a {
		color: var(--sl-color-gray-2);
		text-decoration: none;
	}
	.links a:hover {
		color: var(--sl-color-white);
	}
	.fine {
		margin-top: 1.25rem;
		font-size: var(--text-xs);
	}
</style>
