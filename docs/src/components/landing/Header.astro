---
// The landing page's own header: the lockup, a way into the docs, the repository and the theme switch
import ThemeToggle from './ThemeToggle.astro';
import lockupLight from '../../assets/lockup-light.svg?raw';
import lockupDark from '../../assets/lockup-dark.svg?raw';
---

<header class="header">
	<div class="wrap bar">
		<a href="/" class="brand" aria-label="Umpteenth home">
			<span class="lockup light" set:html={lockupLight} />
			<span class="lockup dark" set:html={lockupDark} />
		</a>
		<nav class="nav" aria-label="Site">
			<a href="/getting-started/introduction/">Docs</a>
			<a href="/getting-started/installation/">Install</a>
			<a href="https://github.com/stonith404/umpteenth" class="github">
				<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
					<path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.3.8-.6v-2c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.4-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.2c0 .3.2.7.8.6 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5Z" />
				</svg>
				GitHub
			</a>
			<ThemeToggle />
		</nav>
	</div>
</header>

<style>
	.header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: color-mix(in oklch, var(--sl-color-bg-nav), transparent 15%);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--sl-color-hairline);
	}
	.wrap {
		max-width: 72rem;
		margin-inline: auto;
		padding-inline: 1.5rem;
	}
	.bar {
		height: 3.5rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		text-decoration: none;
	}
	.lockup :global(svg) {
		display: block;
		height: 1.75rem;
		width: auto;
	}
	.lockup.dark {
		display: none;
	}
	:global([data-theme='dark']) .lockup.light {
		display: none;
	}
	:global([data-theme='dark']) .lockup.dark {
		display: inline;
	}
	.nav {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}
	.nav > a {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		height: 2.125rem;
		padding-inline: 0.75rem;
		border-radius: 0.5rem;
		color: var(--sl-color-gray-2);
		font-size: var(--text-sm);
		font-weight: 500;
		text-decoration: none;
	}
	.nav > a:hover {
		background: var(--sl-color-gray-7);
		color: var(--sl-color-white);
	}
	.nav :global(.theme-toggle) {
		margin-left: 0.5rem;
	}
	@media (max-width: 40rem) {
		.nav > a:not(.github) {
			display: none;
		}
	}
</style>
