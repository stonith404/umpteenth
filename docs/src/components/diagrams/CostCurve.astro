---
// An example job's cost per run, falling while the playbook grows and settling at the main script once the job graduates
import Figure from '../Figure.astro';
import { dg } from './classes';
import { field } from './dither';

interface Props {
	caption?: string;
}
const {
	caption = 'Cost per run for the first eight runs of an example job. Reflection adds to the playbook after each run, so the agent needs fewer turns, and from run 6 the main script does the job without the agent for $0.00.'
} = Astro.props;

// A run is Explore only while the playbook is empty, so from run 2 on the agent starts from what reflection saved
// Density is how loose the dither of a run's bar is: sparse dots while the agent explores, the solid lime bar once a script runs
const runs = [
	{ n: 1, mode: 'Explore', time: '4m 12s', cost: 0.42, density: 0.15 },
	{ n: 2, mode: 'Assisted', time: '3m 40s', cost: 0.37, density: 0.3 },
	{ n: 3, mode: 'Assisted', time: '1m 58s', cost: 0.19, density: 0.5 },
	{ n: 4, mode: 'Assisted', time: '1m 05s', cost: 0.11, density: 0.7 },
	{ n: 5, mode: 'Assisted', time: '52s', cost: 0.08, density: 0.9 },
	{ n: 6, mode: 'Scripted', time: '3s', cost: 0, density: 1 },
	{ n: 7, mode: 'Scripted', time: '3s', cost: 0, density: 1 },
	{ n: 8, mode: 'Scripted', time: '2s', cost: 0, density: 1 }
];

// One 78 unit column per run right of the axis labels, with a bar of 4 unit dither cells centered in it
const plot = { left: 56, top: 40, base: 220, pitch: 78 };
const cell = 4;
const barW = 10 * cell;
const perDollar = 360;
const column = (i: number) => plot.left + plot.pitch * i;
const center = (i: number) => column(i) + plot.pitch / 2;

// Heights snap to whole cells, and a run that cost nothing keeps one row so its lime bar stays visible
const bars = runs.map((r, i) => {
	const rows = Math.max(1, Math.round((r.cost * perDollar) / cell));
	const x = center(i) - barW / 2;
	const y = plot.base - rows * cell;
	return { ...r, x, y, cells: field(barW / cell, rows, r.density) };
});

const grid = [0.1, 0.2, 0.3, 0.4].map((v) => ({ y: plot.base - v * perDollar, label: `$${v.toFixed(2)}` }));

// Rows under the baseline: the run number, its duration, then a bracket per mode
const rowRun = plot.base + 18;
const rowTime = plot.base + 34;
const rowBracket = plot.base + 50;
const rowMode = plot.base + 68;
const groups = [
	{ mode: 'Explore', from: 0, to: 0 },
	{ mode: 'Assisted', from: 1, to: 4 },
	{ mode: 'Scripted', from: 5, to: 7, lime: true }
].map((g) => ({ ...g, x1: column(g.from) + 8, x2: column(g.to + 1) - 8 }));

// The job graduates between run 5 and run 6, where the first scripted run starts
const graduation = column(5);

// Chart parts the shared diagram classes don't cover, themed through the same colors
const cc = {
	grid: 'stroke-dg-edge stroke-1 [stroke-dasharray:2_3]',
	base: 'stroke-dg-line stroke-1',
	axis: 'fill-dg-muted text-[11px]',
	value: 'fill-dg-ink font-mono text-[11px]',
	run: 'fill-dg-muted font-mono text-[11px]',
	bracket: 'fill-none stroke-dg-line stroke-1',
	bracketLime: 'fill-none stroke-dg-lime-line stroke-[1.5]',
	mode: 'fill-dg-ink text-[12px] font-semibold',
	modeLime: 'fill-dg-lime-line text-[12px] font-semibold',
	// The graduation marker is dashed, since it marks the moment between two runs
	marker: 'stroke-dg-lime-line stroke-[1.5] [stroke-dasharray:4_3]',
	mark: 'fill-dg-lime-line text-[12px] font-semibold',
	note: 'fill-dg-muted text-[11px]',
	// A bar's cells overlap by a tenth of a unit to close hairline gaps, so the dots take their opacity as one group instead of doubling it where they meet
	dots: 'opacity-55',
	dot: 'fill-dg-ink'
};
---

<Figure caption={caption}>
	<svg viewBox="0 0 680 300" role="img" aria-label={caption}>
		<text class={dg.zoneLabel} x="0" y="14">Example: weekly stale PR report</text>

		{
			grid.map((g) => (
				<g>
					<line class={cc.grid} x1={plot.left} y1={g.y} x2="680" y2={g.y} />
					<text class={cc.axis} x={plot.left - 10} y={g.y + 4} text-anchor="end">
						{g.label}
					</text>
				</g>
			))
		}

		<line class={cc.marker} x1={graduation} y1="26" x2={graduation} y2={rowTime + 8} />
		<text class={cc.mark} x={graduation + 8} y="36">
			Graduated
		</text>
		<text class={cc.note} x={graduation + 8} y="51">
			the main script runs, no agent
		</text>

		{
			bars.map((b) => (
				<g>
					<g class={b.density < 1 ? cc.dots : undefined}>
						{b.cells.map((c) => (
							<rect class={c.bar ? dg.bar : cc.dot} x={b.x + c.x * cell} y={b.y + c.y * cell} width={cell + 0.1} height={cell + 0.1} />
						))}
					</g>
					<text class={cc.value} x={b.x + barW / 2} y={b.y - 8} text-anchor="middle">
						${b.cost.toFixed(2)}
					</text>
				</g>
			))
		}
		<line class={cc.base} x1={plot.left} y1={plot.base} x2="680" y2={plot.base} />

		<text class={cc.axis} x={plot.left - 10} y={rowRun + 4} text-anchor="end">run</text>
		<text class={cc.axis} x={plot.left - 10} y={rowTime + 4} text-anchor="end">time</text>
		{
			bars.map((b, i) => (
				<g>
					<text class={cc.run} x={center(i)} y={rowRun + 4} text-anchor="middle">
						#{b.n}
					</text>
					<text class={cc.value} x={center(i)} y={rowTime + 4} text-anchor="middle">
						{b.time}
					</text>
				</g>
			))
		}

		{
			groups.map((g) => (
				<g>
					<path class={g.lime ? cc.bracketLime : cc.bracket} d={`M${g.x1},${rowBracket - 5} V${rowBracket} H${g.x2} V${rowBracket - 5}`} />
					<text class={g.lime ? cc.modeLime : cc.mode} x={(g.x1 + g.x2) / 2} y={rowMode} text-anchor="middle">
						{g.mode}
					</text>
				</g>
			))
		}
	</svg>
</Figure>
