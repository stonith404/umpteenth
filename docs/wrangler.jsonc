// The docs are a static Astro build served by a Cloudflare Worker with static assets and no Worker code
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "umpteenth-docs",
	"compatibility_date": "2026-09-27",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page"
	},
	"workers_dev": false,
	"routes": [{ "pattern": "umpteenth.dev", "custom_domain": true }]
}
