#!/usr/bin/env python3
# ump:name        fetch_front_page
# ump:description Fetch the Hacker News front page and save the stories as JSON, sorted by points
# ump:args        {"limit":"integer","out":"string"}
# ump:side-effects none
import argparse
import json
import urllib.request

parser = argparse.ArgumentParser()
parser.add_argument("--limit", type=int, default=30)
parser.add_argument("--out", required=True)
args = parser.parse_args()

# The Algolia API returns points and comment counts in one request, the Firebase API needs one request per story
url = f"https://hn.algolia.com/api/v1/search?tags=front_page&hitsPerPage={args.limit}"
with urllib.request.urlopen(url, timeout=20) as response:
    hits = json.load(response)["hits"]

# Ask HN and Show HN posts have no URL, so they link to their comments page
stories = [
    {
        "id": int(hit["objectID"]),
        "title": hit["title"],
        "url": hit.get("url") or f"https://news.ycombinator.com/item?id={hit['objectID']}",
        "points": hit.get("points") or 0,
        "comments": hit.get("num_comments") or 0,
    }
    for hit in hits
]
stories.sort(key=lambda story: story["points"], reverse=True)

with open(args.out, "w") as f:
    json.dump(stories, f, indent=2)
print(f"Saved {len(stories)} stories to {args.out}")
