{
	"version": "0.0.1",
	"configurations": [
		{
			"name": "frontend",
			"runtimeExecutable": "pnpm",
			"runtimeArgs": [
				"--filter",
				"umpteenth-frontend",
				"dev"
			],
			"port": 3000
		},
		{
			"name": "docs",
			"runtimeExecutable": "pnpm",
			"runtimeArgs": [
				"--filter",
				"umpteenth-docs",
				"dev"
			],
			"port": 4321
		},
		{
			"name": "docs-preview",
			"runtimeExecutable": "pnpm",
			"runtimeArgs": [
				"--filter",
				"umpteenth-docs",
				"exec",
				"astro",
				"preview",
				"--port",
				"4322"
			],
			"port": 4322
		}
	]
